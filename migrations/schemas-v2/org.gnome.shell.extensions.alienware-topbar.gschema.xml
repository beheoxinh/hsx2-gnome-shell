<?xml version="1.0" encoding="UTF-8"?>
<!--
  Frozen copy of the alienware-topbar keys that moved to
  org.gnome.shell.extensions.gnome-customizer-manager (Quick Settings and
  Clock & Calendar). Read once by migrations.js step v2; never registered with
  the shell. Same id and path as the live schema on purpose: dconf stores
  values by path, so this is how the old values are still reachable.
-->
<schemalist>
  <enum id="org.gnome.shell.extensions.alienware-topbar.clock-position">
    <value nick="left" value="0"/>
    <value nick="center" value="1"/>
    <value nick="right" value="2"/>
  </enum>

  <schema id="org.gnome.shell.extensions.alienware-topbar"
          path="/org/gnome/shell/extensions/alienware-topbar/">

    <!-- Clock and calendar -->
    <key name="clock-visible" type="b">
      <default>false</default>
      <summary>Show the clock</summary>
    </key>

    <key name="clock-position" enum="org.gnome.shell.extensions.alienware-topbar.clock-position">
      <default>'center'</default>
      <summary>Clock position</summary>
      <description>Which top bar section holds the clock. This is the only place allowed to reparent the date menu.</description>
    </key>

    <key name="clock-position-offset" type="i">
      <default>0</default>
      <range min="-64" max="64"/>
      <summary>Clock offset</summary>
      <description>Extra pixels inserted in front of the clock, used to balance the other panel items.</description>
    </key>

    <key name="world-clock" type="b">
      <default>true</default>
      <summary>World clocks in the calendar</summary>
    </key>

    <key name="weather" type="b">
      <default>true</default>
      <summary>Weather in the calendar</summary>
    </key>

    <key name="events-button" type="b">
      <default>true</default>
      <summary>Events button in the calendar</summary>
    </key>

    <key name="calendar" type="b">
      <default>true</default>
      <summary>Calendar in the calendar popup</summary>
    </key>

    <key name="invert-calendar-column-items" type="b">
      <default>false</default>
      <summary>Invert calendar column items</summary>
    </key>

    <!-- Quick settings -->
    <key name="quick-settings" type="b">
      <default>true</default>
      <summary>Show the quick settings menu</summary>
    </key>

    <key name="quick-settings-dark-mode" type="b">
      <default>true</default>
      <summary>Dark mode toggle in quick settings</summary>
    </key>

    <key name="quick-settings-night-light" type="b">
      <default>true</default>
      <summary>Night light toggle in quick settings</summary>
    </key>

    <key name="quick-settings-do-not-disturb" type="b">
      <default>true</default>
      <summary>Do not disturb toggle in quick settings</summary>
    </key>

    <key name="quick-settings-backlight" type="b">
      <default>true</default>
      <summary>Backlight slider in quick settings</summary>
    </key>

    <key name="quick-settings-airplane-mode" type="b">
      <default>true</default>
      <summary>Airplane mode toggle in quick settings</summary>
    </key>
  </schema>
</schemalist>
