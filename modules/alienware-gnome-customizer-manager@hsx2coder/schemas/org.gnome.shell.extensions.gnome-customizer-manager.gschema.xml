<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <enum id="org.gnome.shell.extensions.gnome-customizer-manager.clock-position">
    <value nick="left" value="0"/>
    <value nick="center" value="1"/>
    <value nick="right" value="2"/>
  </enum>

  <schema id="org.gnome.shell.extensions.gnome-customizer-manager"
    path="/org/gnome/shell/extensions/gnome-customizer-manager/">

    <!-- Animation -->
    <key type="i" name="animation">
      <default>1</default>
      <range min="0" max="8"/>
      <summary>Animation speed</summary>
      <description>0 off, 1 GNOME default, 2 almost none, 3 fastest, 4 faster, 5 fast, 6 slow, 7 slower, 8 slowest. Off is session-only: org.gnome.desktop.interface enable-animations is left alone.</description>
    </key>

    <!-- Window -->
    <key type="b" name="window-demands-attention-focus">
      <default>true</default>
      <summary>Focus Window on Demand Attention</summary>
    </key>
    <key type="b" name="window-maximized-on-create">
      <default>false</default>
      <summary>Maximize Window on Create</summary>
    </key>
    <key type="b" name="window-picker-icon">
      <default>true</default>
      <summary>Window Picker Icon</summary>
    </key>
    <key type="b" name="window-menu">
      <default>true</default>
      <summary>Window Menu</summary>
    </key>
    <key type="b" name="window-menu-take-screenshot-button">
      <default>true</default>
      <summary>Screenshot Button in Window Menu</summary>
    </key>
    <key type="b" name="fullscreen-unredirect">
      <default>true</default>
      <summary>Unredirect fullscreen windows</summary>
      <description>GNOME's default. Turn off to keep fullscreen windows composited: fixes flicker, tearing and OSD/notifications not showing over fullscreen apps, at a small performance cost.</description>
    </key>

    <!-- OSD -->
    <key type="b" name="osd">
      <default>true</default>
      <summary>OSD Visibility</summary>
    </key>
    <key type="i" name="osd-position">
      <default>0</default>
      <range min="0" max="9"/>
      <summary>OSD Position</summary>
      <description>0 default, then top start/center/end, bottom start/center/end, center start/center/end</description>
    </key>

    <!-- Quick Settings — moved from alienware-topbar -->
    <key name="quick-settings" type="b">
      <default>true</default>
      <summary>Show the quick settings menu</summary>
    </key>

    <key name="quick-settings-dark-mode" type="b">
      <default>true</default>
      <summary>Dark mode toggle in quick settings</summary>
    </key>

    <key name="quick-settings-night-light" type="b">
      <default>true</default>
      <summary>Night light toggle in quick settings</summary>
    </key>

    <key name="quick-settings-do-not-disturb" type="b">
      <default>true</default>
      <summary>Do not disturb toggle in quick settings</summary>
    </key>

    <key name="quick-settings-backlight" type="b">
      <default>true</default>
      <summary>Backlight slider in quick settings</summary>
    </key>

    <key name="quick-settings-airplane-mode" type="b">
      <default>true</default>
      <summary>Airplane mode toggle in quick settings</summary>
    </key>

    <!-- Theme -->
    <key type="b" name="theme">
      <default>true</default>
      <summary>Flat popup style</summary>
      <description>Adds the just-perfection style class: flat OSD, Alt+Tab switcher, workspace popup and tile previews.</description>
    </key>

    <!-- Screenshot -->
    <key type="b" name="remove-preselected-box">
      <default>true</default>
      <summary>Remove Screenshot Preselected Box</summary>
    </key>
    <key type="b" name="screenshot-on-release">
      <default>true</default>
      <summary>Screenshot On Mouse Release</summary>
    </key>

    <!-- Clock & Calendar (date menu) — moved from alienware-topbar -->
    <key name="clock-visible" type="b">
      <default>true</default>
      <summary>Show the clock</summary>
      <description>System Monitor (Topbar module) still takes the clock's place while it runs, through lib/dateMenuVisibility.js; this key no longer has to be flipped for it.</description>
    </key>

    <key name="clock-position" enum="org.gnome.shell.extensions.gnome-customizer-manager.clock-position">
      <default>'center'</default>
      <summary>Clock position</summary>
      <description>Which top bar section holds the clock. This is the only place allowed to reparent the date menu.</description>
    </key>

    <key name="clock-position-offset" type="i">
      <default>0</default>
      <range min="-64" max="64"/>
      <summary>Clock offset</summary>
      <description>Extra pixels inserted in front of the clock, used to balance the other panel items.</description>
    </key>

    <key name="world-clock" type="b">
      <default>true</default>
      <summary>World clocks in the calendar</summary>
    </key>

    <key name="weather" type="b">
      <default>true</default>
      <summary>Weather in the calendar</summary>
    </key>

    <key name="events-button" type="b">
      <default>true</default>
      <summary>Events button in the calendar</summary>
    </key>

    <key name="calendar" type="b">
      <default>true</default>
      <summary>Calendar in the calendar popup</summary>
    </key>

    <key name="invert-calendar-column-items" type="b">
      <default>true</default>
      <summary>Invert calendar column items</summary>
    </key>

    <key type="b" name="workspace">
        <default>true</default>
        <summary>Workspace Switcher</summary>
        <description>Workspace Switcher Visibility Status</description>
    </key>
    <key type="b" name="workspace-popup">
        <default>true</default>
        <summary>Workspace Popup</summary>
        <description>Workspace Popup Visibility Status</description>
    </key>
    <key type="i" name="workspace-switcher-size">
        <default>0</default>
        <range min="0" max="30" />
        <summary>Workspace Switcher Size in percent, 0 means use default size</summary>
        <description>Workspace Switcher Size</description>
    </key>
    <key type="b" name="workspace-switcher-should-show">
        <default>false</default>
        <summary>Always Show Workspaces Switcher</summary>
        <description>Always Show Workspace Switcher Status</description>
    </key>
    <key type="b" name="workspace-wrap-around">
        <default>false</default>
        <summary>Workspace Wrap Around</summary>
        <description>Workspace Wrap Around Status</description>
    </key>
    <key type="b" name="workspace-peek">
        <default>true</default>
        <summary>Workspace Peek</summary>
        <description>Workspace Peek Status</description>
    </key>
    <key type="b" name="workspaces-in-app-grid">
        <default>true</default>
        <summary>Workspaces Visiblity in App Grid</summary>
        <description>Workspaces Visiblity in App Grid Status</description>
    </key>
    <key type="i" name="workspace-background-corner-size">
        <default>0</default>
        <range min="0" max="61" />
        <summary>0 means use default shell size, 1 means no radius, 2 - 61 means radius size</summary>
        <description>Workspace Background Corner Size</description>
    </key>
    <key type="b" name="workspace-thumbnail-to-main-view">
        <default>false</default>
        <summary>Workspace Thumbnail Click Always Goes To The Main View</summary>
        <description>Workspace Thumbnail Click to Main View</description>
    </key>
    <key type="b" name="overlay-key">
        <default>true</default>
        <summary>Overlay Key</summary>
        <description>Overlay Key to Overview Status</description>
    </key>
    <key type="b" name="double-super-to-appgrid">
        <default>true</default>
        <summary>Double Super To App Grid</summary>
        <description>Double Super To App Grid Status</description>
    </key>
    <key type="b" name="ripple-box">
        <default>true</default>
        <summary>Ripple Box</summary>
        <description>Ripple Box Status</description>
    </key>
    <key type="i" name="startup-status">
        <default>1</default>
        <range min="0" max="1" />
        <summary>0 means desktop, 1 means overview</summary>
        <description>Startup Status</description>
    </key>
    <key type="i" name="controls-manager-spacing-size">
        <default>0</default>
        <range min="0" max="150" />
        <summary>0 means default size</summary>
        <description>Controls manager spacing Size (overview spacing)</description>
    </key>
  </schema>
</schemalist>
