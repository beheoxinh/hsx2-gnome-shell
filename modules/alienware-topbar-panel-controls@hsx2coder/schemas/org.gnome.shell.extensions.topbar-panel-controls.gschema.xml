<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.topbar-panel-controls"
    path="/org/gnome/shell/extensions/topbar-panel-controls/">

    <!-- Panel visibility & layout -->
    <key type="b" name="panel">
      <default>true</default>
      <summary>Show Panel</summary>
    </key>
    <key type="b" name="panel-in-overview">
      <default>false</default>
      <summary>Panel in Overview</summary>
    </key>
    <key type="i" name="panel-size">
      <default>0</default>
      <range min="0" max="64"/>
      <summary>Panel Size (0=default)</summary>
    </key>
    <key type="i" name="top-panel-position">
      <default>0</default>
      <range min="0" max="1"/>
      <summary>Top Panel Position</summary>
    </key>
    <key type="i" name="panel-corner-size">
      <default>0</default>
      <range min="0" max="61"/>
      <summary>Panel Corner Size</summary>
    </key>
    <key type="i" name="panel-button-padding-size">
      <default>0</default>
      <range min="0" max="61"/>
      <summary>Panel Button Padding</summary>
    </key>
    <key type="i" name="panel-indicator-padding-size">
      <default>0</default>
      <range min="0" max="61"/>
      <summary>Panel Indicator Padding</summary>
    </key>
    <key type="i" name="panel-icon-size">
      <default>0</default>
      <range min="0" max="60"/>
      <summary>Panel Icon Size</summary>
    </key>

    <!-- Activities -->
    <key type="b" name="activities-button">
      <default>true</default>
      <summary>Show Activities Button</summary>
    </key>
    <key type="b" name="background-menu">
      <default>true</default>
      <summary>Show Background Menu</summary>
    </key>
    <key type="b" name="show-apps-button">
      <default>true</default>
      <summary>Show Apps Button</summary>
    </key>

    <!-- Clock menu -->
    <key type="b" name="clock-menu">
      <default>true</default>
      <summary>Show Clock Menu</summary>
    </key>
    <key type="i" name="clock-menu-position">
      <default>0</default>
      <range min="0" max="2"/>
      <summary>Clock Menu Position</summary>
    </key>
    <key type="i" name="clock-menu-position-offset">
      <default>0</default>
      <range min="0" max="20"/>
      <summary>Clock Menu Position Offset</summary>
    </key>
    <key type="b" name="world-clock">
      <default>true</default>
      <summary>Show World Clock in Menu</summary>
    </key>
    <key type="b" name="weather">
      <default>true</default>
      <summary>Show Weather in Menu</summary>
    </key>
    <key type="b" name="events-button">
      <default>true</default>
      <summary>Show Events in Menu</summary>
    </key>
    <key type="b" name="calendar">
      <default>true</default>
      <summary>Show Calendar in Menu</summary>
    </key>

    <!-- Panel indicators -->
    <key type="b" name="panel-notification-icon">
      <default>true</default>
      <summary>Show Notification Icon in Panel</summary>
    </key>
    <key type="b" name="keyboard-layout">
      <default>true</default>
      <summary>Show Keyboard Layout Indicator</summary>
    </key>
    <key type="b" name="accessibility-menu">
      <default>true</default>
      <summary>Show Accessibility Menu</summary>
    </key>
    <key type="b" name="power-icon">
      <default>true</default>
      <summary>Show Power Icon</summary>
    </key>
    <key type="b" name="screen-sharing-indicator">
      <default>true</default>
      <summary>Show Screen Sharing Indicator</summary>
    </key>
    <key type="b" name="screen-recording-indicator">
      <default>true</default>
      <summary>Show Screen Recording Indicator</summary>
    </key>

    <!-- Search -->
    <key type="b" name="search">
      <default>true</default>
      <summary>Show Search Box</summary>
    </key>
    <key type="b" name="type-to-search">
      <default>true</default>
      <summary>Enable Type to Search</summary>
    </key>

  </schema>
</schemalist>
