<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.touchpad_gpawru" path="/org/gnome/shell/extensions/touchpad_gpawru/">

    <key name="show-indicator" type="b">
      <default>true</default>
    </key>
    <key name="show-notifications" type="b">
      <default>true</default>
      <summary>Show notification</summary>
      <description>Show OSD notification when toggling touchpad.</description>
    </key>
    <key name="toggle-shortcut" type="as">
      <default><![CDATA[['<Super>Insert', 'XF86TouchpadToggle']]]></default>
      <summary>Touchpad toggle shortcut</summary>
      <description>Shortcut to toggle the touchpad state.</description>
    </key>
    
  </schema>
</schemalist>