<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.alienware-suite"
          path="/org/gnome/shell/extensions/alienware-suite/">
    <key name="enable-advanced-media-controller" type="b">
      <default>false</default>
      <summary>Enable the Advanced Media Controller module</summary>
      <description>Split out of dash-to-panel, which used to carry it in media/.</description>
    </key>
    <key name="enable-dash-to-panel" type="b">
      <default>true</default>
      <summary>Enable Dash to Panel module</summary>
    </key>
    <key name="enable-system-monitor" type="b">
      <default>true</default>
      <summary>Enable System Monitor module</summary>
    </key>
    <key name="enable-indicators" type="b">
      <default>true</default>
      <summary>Enable Indicators module</summary>
      <description>AppIndicator tray icons, Caps/Num lock, and Touchpad toggle.</description>
    </key>
    <key name="enable-desktop-icons" type="b">
      <default>true</default>
      <summary>Enable Desktop Icons NG module</summary>
    </key>
    <key name="enable-advanced-alt-tab" type="b">
      <default>true</default>
      <summary>Enable AATWS module</summary>
      <description>Advanced Alt-Tab Window Switcher — highly customizable Alt+Tab replacement.</description>
    </key>
    <key name="enable-notification-configurator" type="b">
      <default>true</default>
      <summary>Enable Notification Configurator module</summary>
    </key>
    <key name="enable-topbar" type="b">
      <default>true</default>
      <summary>Enable the Topbar &amp; Panel module</summary>
      <description>Panel layout, clock, quick settings, panel items, multi-monitor clone, clipboard and command menu widgets.</description>
    </key>
    <key name="enable-gnome-customizer-manager" type="b">
      <default>true</default>
      <summary>Enable Gnome Customizer Manager module</summary>
    </key>
  </schema>
</schemalist>
