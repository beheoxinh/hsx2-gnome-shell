<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.alienware-suite"
          path="/org/gnome/shell/extensions/alienware-suite/">
    <key name="enable-capsnum-touchpad" type="b">
      <default>true</default>
      <summary>Enable Caps/Num &amp; Touchpad module</summary>
    </key>
    <key name="enable-dash-to-panel" type="b">
      <default>true</default>
      <summary>Enable Dash to Panel module</summary>
    </key>
    <key name="enable-desktop-icons" type="b">
      <default>true</default>
      <summary>Enable Desktop Icons NG module</summary>
    </key>
    <key name="enable-system-monitor" type="b">
      <default>true</default>
      <summary>Enable System Monitor module</summary>
    </key>
    <key name="enable-clipboard-indicator" type="b">
      <default>true</default>
      <summary>Enable Clipboard Indicator module</summary>
    </key>
    <key name="enable-notification-configurator" type="b">
      <default>true</default>
      <summary>Enable Notification Configurator module</summary>
    </key>
    <key name="enable-just-perfection" type="b">
      <default>true</default>
      <summary>Enable Just Perfection module</summary>
    </key>
    <key name="enable-topbar-clone" type="b">
      <default>true</default>
      <summary>Enable Topbar Clone module</summary>
      <description>Clone the native GNOME top bar onto secondary monitors.</description>
    </key>
    <key name="topbar-clone-show-clock" type="b">
      <default>true</default>
      <summary>Show the clock on the cloned top bar</summary>
      <description>Show the Date/Clock menu in the center of the cloned top bar.</description>
    </key>
    <key name="topbar-clone-show-tray" type="b">
      <default>true</default>
      <summary>Show the system tray on the cloned top bar</summary>
      <description>Show the Quick Settings / system tray on the right of the cloned top bar.</description>
    </key>

  </schema>
</schemalist>
